import numpy as np

rng = np.random.default_rng()
numseg = 100

# ---- person generator ---------------------------------------------------
P_MALE = 0.5                             # probability a sampled person is male
AGE_MIN, AGE_MAX = 55, 85                # inclusive

# (age_low, age_high) -> (mean height cm, SD cm); low inclusive, high exclusive
HEIGHT_PARAMS = {
    "M": {(55, 65): (173.3, 6.7), (65, 75): (171.8, 6.7), (75, 86): (168.4, 6.4)},
    "F": {(55, 65): (160.1, 7.5), (65, 75): (158.6, 6.2), (75, 86): (154.8, 6.4)},
}

# ---- body weight (NEW) --------------------------------------------------
# NOTE: placeholders, must be validated.
# VALIDATE: against national survey data (e.g. HSE / NHANES) for BMI by sex and age band.
BMI_PARAMS = {"M": (27.5, 4.2), "F": (27.5, 5.2)}      # (mean, SD) kg/m^2

# ---- femur parameters ---------------------------------------------------
# NOTE: all values in this block are placeholders, not from papers, and must be validated.

# Femur length as a fraction of standing height: (mean, SD)
# VALIDATE: against papers reporting femur length and stature by sex in a similar age range.
FEMUR_RATIO = {"M": (0.270, 0.010), "F": (0.270, 0.010)}

# Mid-shaft outer diameter in mm: (mean, SD)
# VALIDATE: against CT/pQCT/DXA papers reporting femoral mid-shaft outer diameter by sex and age.
SHAFT_DIAM_MM = {"M": (28.0, 2.3), "F": (25.0, 2.2)}

# Typical femur length (cm) used to centre the length-diameter relationship
# VALIDATE: should equal the mean femur length of your sampled population per sex.
FEMUR_LEN_REF_CM = {"M": 46.3, "F": 42.7}

# VALIDATE: against a paper reporting the correlation between femur length and mid-shaft diameter.
RHO_LEN_DIAM = 0.4        # correlation between femur length and shaft diameter

# VALIDATE: should match the SD of femur length in your sampled population (or a published SD).
SD_LEN_CM = 2.5           # approx SD of femur length, used to turn rho into a slope

# Extra parameters for the bone-shaped model (ratio of end width to mid-shaft width)
# VALIDATE: against measured femoral head/trochanter width and distal epicondylar breadth relative to mid-shaft diameter.
PROX_FLARE = 1.9          # head / greater trochanter region
DIST_FLARE = 2.4          # condyles

# ---- mechanical parameters (NEW) ----------------------------------------
# NOTE: placeholders, must be validated.
G = 9.81                                  # m/s^2

# Axial load as a multiple of body weight (uniform between these limits)
LOAD_FACTOR_RANGE = (2.5, 3.0)

# Effective axial modulus in MPa
# VALIDATE: against mechanical testing / CT-based FE literature (cortical ~15-20 GPa, lower for ageing/osteoporotic bone).
E_MPA = 15000.0

# Fraction of each slice's disc area that is actually load-bearing bone
# (the real femur is a hollow cortical shell, a solid disc overstates area)
# VALIDATE: against CT/pQCT cortical area / total area ratios by sex and age.
LOAD_BEARING_AREA_FRAC = 0.45

# Failure reference for a safety factor (compressive yield, MPa)
# VALIDATE: against published cortical bone compressive strength, including age-related decline.
YIELD_COMPRESSION_MPA = 130.0


# ---- sampling functions -------------------------------------------------
def sample_sex(rng):
    return "M" if rng.random() < P_MALE else "F"

def sample_age(rng):
    return int(rng.integers(AGE_MIN, AGE_MAX + 1))   # uniform over whole years

def sample_height_cm(sex, age, rng):
    for (lo, hi), (mean, sd) in HEIGHT_PARAMS[sex].items():
        if lo <= age < hi:
            return rng.normal(mean, sd)
    raise ValueError(f"No height band for sex={sex}, age={age}")

def sample_weight_kg(sex, height_cm, rng):
    mean, sd = BMI_PARAMS[sex]
    bmi = max(rng.normal(mean, sd), 15.0)            # floor to avoid absurd values
    return bmi * (height_cm / 100) ** 2

def sample_femur_length_cm(sex, height_cm, rng):
    mean, sd = FEMUR_RATIO[sex]
    return height_cm * rng.normal(mean, sd)

def sample_shaft_diameter_mm(sex, length_cm, rng):
    mean_d, sd_d = SHAFT_DIAM_MM[sex]
    slope = RHO_LEN_DIAM * sd_d / SD_LEN_CM                 # mm per cm of length
    resid_sd = sd_d * np.sqrt(1 - RHO_LEN_DIAM**2)          # keeps overall SD ~ sd_d
    return mean_d + slope * (length_cm - FEMUR_LEN_REF_CM[sex]) + rng.normal(0, resid_sd)


# ---- geometry model (stack of discs with varying diameter) --------------
def diameter_profile(s):
    """Diameter multiplier along the bone; s runs 0 (hip end) to 1 (knee end)."""
    # VALIDATE: fit the end positions and widths (0.04, 0.07, 1.00, 0.10) to measured femur width profiles from CT/DXA or a shape model.
    prox = (PROX_FLARE - 1) * np.exp(-((s - 0.04) / 0.07) ** 2)
    dist = (DIST_FLARE - 1) * np.exp(-((s - 1.00) / 0.10) ** 2)
    return 1 + prox + dist

def shaped_femur(length_cm, shaft_diam_mm, numseg=100):
    s = (np.arange(numseg) + 0.5) / numseg                   # slice midpoints
    d_mm = shaft_diam_mm * diameter_profile(s)               # diameter of each slice
    dz = length_cm / numseg                                  # slice thickness
    volume = np.sum(np.pi * (d_mm / 20) ** 2 * dz)
    return {"length_cm": length_cm, "z_cm": s * length_cm,
            "diameter_mm": d_mm, "volume_cm3": volume}


# ---- axial loading (NEW) ------------------------------------------------
def axial_load(femur, weight_kg, load_factor):
    """Apply an axial force (load_factor x body weight) through the femur.

    Treats the femur as a stack of springs in series carrying the same force F.
    Returns force, stress profile, strain profile, total shortening, stiffness.
    """
    force_n = load_factor * weight_kg * G                          # N
    area_mm2 = np.pi * (femur["diameter_mm"] / 2) ** 2 * LOAD_BEARING_AREA_FRAC
    stress_mpa = force_n / area_mm2                                # N/mm^2 = MPa
    strain = stress_mpa / E_MPA                                    # dimensionless
    dz_mm = femur["length_cm"] * 10 / len(area_mm2)                # slice thickness
    shortening_mm = np.sum(strain * dz_mm)                         # sum of slice strains
    return {
        "load_factor": load_factor,
        "force_n": force_n,
        "stress_mpa": stress_mpa,
        "strain": strain,
        "peak_stress_mpa": stress_mpa.max(),                       # at the thinnest slice
        "midshaft_stress_mpa": stress_mpa[len(stress_mpa) // 2],
        "shortening_mm": shortening_mm,
        "axial_stiffness_n_per_mm": force_n / shortening_mm,
        "safety_factor": YIELD_COMPRESSION_MPA / stress_mpa.max(),
    }


# ---- full person --------------------------------------------------------
def sample_person(rng):
    sex = sample_sex(rng)
    age = sample_age(rng)
    height = sample_height_cm(sex, age, rng)
    weight = sample_weight_kg(sex, height, rng)
    length = sample_femur_length_cm(sex, height, rng)
    diam = sample_shaft_diameter_mm(sex, length, rng)
    shaped = shaped_femur(length, diam, numseg)
    load_factor = rng.uniform(*LOAD_FACTOR_RANGE)
    return {"sex": sex, "age": age, "height_cm": height, "weight_kg": weight,
            "femur_length_cm": length, "shaft_diam_mm": diam,
            "shaped": shaped, "loading": axial_load(shaped, weight, load_factor)}


# ---- check the sampler reproduces your inputs --------------------------
if __name__ == "__main__":
    people = [sample_person(rng) for _ in range(20000)]

    # height check
    for sex in ("M", "F"):
        for (lo, hi), (mean, sd) in HEIGHT_PARAMS[sex].items():
            h = [p["height_cm"] for p in people
                 if p["sex"] == sex and lo <= p["age"] < hi]
            print(f"{sex} {lo}-{hi-1}: sampled mean {np.mean(h):.1f} (target {mean}), "
                  f"SD {np.std(h):.1f} (target {sd}), n={len(h)}")

    # femur check
    for sex in ("M", "F"):
        sub = [p for p in people if p["sex"] == sex]
        print(sex,
              f"femur length {np.mean([p['femur_length_cm'] for p in sub]):.1f} cm,",
              f"shaft diameter {np.mean([p['shaft_diam_mm'] for p in sub]):.1f} mm,",
              f"shaped vol {np.mean([p['shaped']['volume_cm3'] for p in sub]):.0f} cm3")

    # loading check
    print("\nAxial loading (2.5-3x body weight):")
    for sex in ("M", "F"):
        sub = [p for p in people if p["sex"] == sex]
        L = [p["loading"] for p in sub]
        print(sex,
              f"weight {np.mean([p['weight_kg'] for p in sub]):.1f} kg,",
              f"force {np.mean([l['force_n'] for l in L]):.0f} N,",
              f"mid-shaft stress {np.mean([l['midshaft_stress_mpa'] for l in L]):.1f} MPa,",
              f"peak stress {np.mean([l['peak_stress_mpa'] for l in L]):.1f} MPa,",
              f"shortening {np.mean([l['shortening_mm'] for l in L]):.3f} mm,",
              f"stiffness {np.mean([l['axial_stiffness_n_per_mm'] for l in L]):.0f} N/mm,",
              f"safety factor {np.mean([l['safety_factor'] for l in L]):.1f}")

    # VALIDATION NOTE: the load model, modulus, area fraction and yield strength are
    # placeholders; validate against published femur loading and testing/FE studies.
