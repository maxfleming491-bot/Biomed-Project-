import numpy as np

rng = np.random.default_rng()
numseg = 100                 # spatial slices along the femur (same as the healthy model)

# =========================================================================
# NOTE: every number in this file is a PLACEHOLDER. None come from papers.
# All of them, especially the PAGET'S blocks, must be validated against the
# literature (or your own data) before the results are used for anything.
# =========================================================================

# ---- person generator ---------------------------------------------------
P_MALE = 0.5                             # probability a sampled person is male
AGE_MIN, AGE_MAX = 50, 85                # inclusive; Paget's only modelled from 50

# (age_low, age_high) -> (mean height cm, SD cm); low inclusive, high exclusive
# VALIDATE: the 50-64 band reuses the 55-64 values from the healthy model as a placeholder.
HEIGHT_PARAMS = {
    "M": {(50, 65): (173.3, 6.7), (65, 75): (171.8, 6.7), (75, 86): (168.4, 6.4)},
    "F": {(50, 65): (160.1, 7.5), (65, 75): (158.6, 6.2), (75, 86): (154.8, 6.4)},
}

# ---- healthy femur parameters (from the healthy model) ------------------
# VALIDATE: all values in this block, as in the healthy model.
FEMUR_RATIO = {"M": (0.270, 0.010), "F": (0.270, 0.010)}
SHAFT_DIAM_MM = {"M": (28.0, 2.3), "F": (25.0, 2.2)}
FEMUR_LEN_REF_CM = {"M": 46.3, "F": 42.7}
RHO_LEN_DIAM = 0.4
SD_LEN_CM = 2.5
PROX_FLARE = 1.9
DIST_FLARE = 2.4

# ---- healthy mass and mineral-loss parameters (from the healthy model) --
# VALIDATE: all values in this block, as in the healthy model.
BONE_DENSITY_REF = {"M": 1.25, "F": 1.20}     # g/cm3 effective whole-bone density at AGE_REF
AGE_REF = 50
BMD_LOSS_PER_YEAR = {"M": 0.004, "F": 0.008}
BMD_FACTOR_SD = 0.10
BMD_FACTOR_MIN = 0.30
SIGMA_ULT_REF_MPA = 150.0
STRENGTH_DENSITY_EXP = 2.0

# ---- Paget's disease timeline -------------------------------------------
# Disease time is counted in segments: 5 segments per year, so 1 segment = 0.2 years.
SEGMENTS_PER_YEAR = 5

# Onset age is sampled uniformly between ONSET_AGE_MIN and the patient's current age,
# so a 50-year-old has had (almost) no time for disease to progress, and a 75-year-old
# can have up to 25 years (125 segments).
# VALIDATE: onset-age distribution against Paget's epidemiology (incidence by age and sex).
ONSET_AGE_MIN = 50

# The lesion starts at one end of the femur and its active front advances along the bone.
# VALIDATE: spread rate (cm/year) against longitudinal radiological studies of lesion progression.
LESION_FRONT_CM_PER_YEAR = 1.0
# VALIDATE: probability the lesion starts at the proximal (hip) end rather than the distal (knee) end.
P_START_PROXIMAL = 0.7

# Local severity rises towards 1 with time since the front reached that slice:
#   severity = 1 - exp(-local_years / TAU_YEARS)
# VALIDATE: time constant of the local remodelling response (lytic -> mixed -> sclerotic phases).
TAU_YEARS = 10.0

# Between-patient variability in severity (lognormal multiplier on severity, capped at 1).
# VALIDATE: spread of severity against clinical series.
SEVERITY_SCALE_SIGMA = 0.25

# ---- Paget's effect sizes at full severity (placeholders) ---------------
# VALIDATE: every value below against CT/DXA/biomechanical studies of pagetic femora.
MAX_DIAM_EXPANSION = 0.25     # fractional increase in outer diameter (bone enlargement)
MAX_LENGTH_INCREASE = 0.02    # fractional increase in femur length (scaled by mean severity)
MAX_BOW_MM = 15.0             # peak lateral bowing at full severity over the whole bone
PAGET_DENSITY_GAIN = 0.15     # extra effective density at full severity (sclerotic, disorganised bone)
PAGET_STRENGTH_FRAC = 0.55    # material strength as a fraction of normal at full severity (woven bone)


# ---- sampling functions -------------------------------------------------
def sample_sex(rng):
    return "M" if rng.random() < P_MALE else "F"

def sample_age(rng):
    return int(rng.integers(AGE_MIN, AGE_MAX + 1))   # uniform over whole years

def sample_height_cm(sex, age, rng):
    for (lo, hi), (mean, sd) in HEIGHT_PARAMS[sex].items():
        if lo <= age < hi:
            return rng.normal(mean, sd)
    raise ValueError(f"No height band for sex={sex}, age={age}")

def sample_femur_length_cm(sex, height_cm, rng):
    mean, sd = FEMUR_RATIO[sex]
    return height_cm * rng.normal(mean, sd)

def sample_shaft_diameter_mm(sex, length_cm, rng):
    mean_d, sd_d = SHAFT_DIAM_MM[sex]
    slope = RHO_LEN_DIAM * sd_d / SD_LEN_CM                 # mm per cm of length
    resid_sd = sd_d * np.sqrt(1 - RHO_LEN_DIAM**2)          # keeps overall SD ~ sd_d
    return mean_d + slope * (length_cm - FEMUR_LEN_REF_CM[sex]) + rng.normal(0, resid_sd)

def sample_bmd_factor(sex, age, rng):
    """Density relative to the reference density: falls with age, with person-to-person scatter."""
    mean_factor = 1 - BMD_LOSS_PER_YEAR[sex] * (age - AGE_REF)
    return max(BMD_FACTOR_MIN, rng.normal(mean_factor, BMD_FACTOR_SD))

def sample_disease_segments(age, rng):
    """Segments of disease so far. Onset can't precede ONSET_AGE_MIN, so a 50-year-old has ~0."""
    onset_age = rng.uniform(ONSET_AGE_MIN, max(age, ONSET_AGE_MIN + 1e-9))
    return int(round((age - onset_age) * SEGMENTS_PER_YEAR))


# ---- healthy geometry, mass and strength (from the healthy model) -------
def diameter_profile(s):
    """Diameter multiplier along the bone; s runs 0 (hip end) to 1 (knee end)."""
    # VALIDATE: fit the end positions and widths (0.04, 0.07, 1.00, 0.10) to measured femur width profiles.
    prox = (PROX_FLARE - 1) * np.exp(-((s - 0.04) / 0.07) ** 2)
    dist = (DIST_FLARE - 1) * np.exp(-((s - 1.00) / 0.10) ** 2)
    return 1 + prox + dist

def shaped_femur(length_cm, shaft_diam_mm, numseg=100):
    s = (np.arange(numseg) + 0.5) / numseg                   # slice midpoints
    d_mm = shaft_diam_mm * diameter_profile(s)               # diameter of each slice
    dz = length_cm / numseg                                  # slice thickness
    volume = np.sum(np.pi * (d_mm / 20) ** 2 * dz)
    return {"length_cm": length_cm, "z_cm": s * length_cm,
            "diameter_mm": d_mm, "volume_cm3": volume}

def bone_mass_and_strength(sex, bmd_factor, bone):
    """Healthy femur: mass (g) and bending strength from the density factor."""
    density = BONE_DENSITY_REF[sex] * bmd_factor              # g/cm3
    mass_g = density * bone["volume_cm3"]
    sigma_mpa = SIGMA_ULT_REF_MPA * bmd_factor ** STRENGTH_DENSITY_EXP
    # VALIDATE: a solid circular section overstates bending strength; compare with a hollow cortical-shell model.
    section_modulus_mm3 = np.pi * bone["diameter_mm"] ** 3 / 32
    failure_moment_Nm = sigma_mpa * section_modulus_mm3 / 1000
    return {"density_g_cm3": density, "mass_g": mass_g,
            "sigma_ult_mpa": sigma_mpa,
            "failure_moment_Nm": failure_moment_Nm,
            "weakest_moment_Nm": failure_moment_Nm.min()}


# ---- Paget's femur ------------------------------------------------------
def pagetic_femur(sex, bmd_factor, length_cm, shaft_diam_mm, n_disease_seg, rng, numseg=100):
    """Step the disease forward one segment (0.2 y) at a time, then build the diseased femur."""
    s = (np.arange(numseg) + 0.5) / numseg                    # slice midpoints, 0 = hip end
    dt = 1.0 / SEGMENTS_PER_YEAR                              # years per segment

    # Where does the lesion start, and how far is each slice from that start?
    from_prox = rng.random() < P_START_PROXIMAL
    dist_from_start_cm = (s if from_prox else 1 - s) * length_cm

    # Progression: each segment the front advances and every slice it has reached ages by dt.
    local_years = np.zeros(numseg)
    front_cm = 0.0
    for _ in range(n_disease_seg):
        front_cm += LESION_FRONT_CM_PER_YEAR * dt
        local_years[dist_from_start_cm <= front_cm] += dt

    # Local severity, with a per-patient scale factor
    sev_scale = rng.lognormal(0, SEVERITY_SCALE_SIGMA)
    severity = np.clip((1 - np.exp(-local_years / TAU_YEARS)) * sev_scale, 0, 1)
    affected = local_years > 0
    mean_sev = severity.mean()

    # Geometry: enlargement, lengthening, bowing
    d_healthy_mm = shaft_diam_mm * diameter_profile(s)
    d_mm = d_healthy_mm * (1 + MAX_DIAM_EXPANSION * severity)
    length_new_cm = length_cm * (1 + MAX_LENGTH_INCREASE * mean_sev)
    bow_mm = MAX_BOW_MM * mean_sev * 4 * s * (1 - s)          # parabolic lateral bow, zero at both ends
    dz = length_new_cm / numseg
    slice_volume_cm3 = np.pi * (d_mm / 20) ** 2 * dz

    # Mechanical properties (per slice), built on the patient's age-related density factor.
    # VALIDATE: both Paget's modifiers (density gain, strength fraction) against mechanical testing of pagetic bone.
    density = BONE_DENSITY_REF[sex] * bmd_factor * (1 + PAGET_DENSITY_GAIN * severity)     # g/cm3
    mass_g = np.sum(density * slice_volume_cm3)
    sigma_mpa = (SIGMA_ULT_REF_MPA * bmd_factor ** STRENGTH_DENSITY_EXP
                 * (1 - (1 - PAGET_STRENGTH_FRAC) * severity))
    # VALIDATE: solid-circle section as in the healthy model; pagetic cortex is also thickened and porous.
    section_modulus_mm3 = np.pi * d_mm ** 3 / 32
    failure_moment_Nm = sigma_mpa * section_modulus_mm3 / 1000

    return {
        "length_cm": length_new_cm, "z_cm": s * length_new_cm,
        "n_disease_seg": n_disease_seg, "duration_years": n_disease_seg * dt,
        "lesion_from_prox": from_prox, "lesion_extent_frac": affected.mean(),
        "severity": severity, "affected": affected,
        "diameter_mm": d_mm, "bow_mm": bow_mm, "volume_cm3": slice_volume_cm3.sum(),
        "density_g_cm3": density, "mass_g": mass_g,
        "sigma_ult_mpa": sigma_mpa, "failure_moment_Nm": failure_moment_Nm,
        "weakest_moment_Nm": failure_moment_Nm.min(),
    }


# ---- full person --------------------------------------------------------
def sample_person(rng):
    sex = sample_sex(rng)
    age = sample_age(rng)
    height = sample_height_cm(sex, age, rng)
    length = sample_femur_length_cm(sex, height, rng)
    diam = sample_shaft_diameter_mm(sex, length, rng)
    bmd_factor = sample_bmd_factor(sex, age, rng)
    n_seg = sample_disease_segments(age, rng)

    healthy_bone = shaped_femur(length, diam, numseg)
    healthy_mech = bone_mass_and_strength(sex, bmd_factor, healthy_bone)   # same person without Paget's
    paget = pagetic_femur(sex, bmd_factor, length, diam, n_seg, rng, numseg)
    return {"sex": sex, "age": age, "height_cm": height,
            "femur_length_cm": length, "shaft_diam_mm": diam,
            "bmd_factor": bmd_factor, "disease_segments": n_seg,
            "shaped": healthy_bone, "mech": healthy_mech, "paget": paget}


# ---- check disease burden rises with age --------------------------------
if __name__ == "__main__":
    people = [sample_person(rng) for _ in range(5000)]

    print("age band | mean disease segments (years) | lesion extent | peak severity | "
          "mass vs healthy | weakest moment vs healthy")
    for lo, hi in [(50, 55), (55, 65), (65, 75), (75, 86)]:
        sub = [p for p in people if lo <= p["age"] < hi]
        segs = np.mean([p["disease_segments"] for p in sub])
        ext = np.mean([p["paget"]["lesion_extent_frac"] for p in sub])
        sev = np.mean([p["paget"]["severity"].max() for p in sub])
        mass_ratio = np.mean([p["paget"]["mass_g"] / p["mech"]["mass_g"] for p in sub])
        mom_ratio = np.mean([p["paget"]["weakest_moment_Nm"] / p["mech"]["weakest_moment_Nm"] for p in sub])
        print(f"{lo}-{hi-1}: {segs:6.1f} ({segs / SEGMENTS_PER_YEAR:4.1f} y)  "
              f"{ext:5.2f}  {sev:5.2f}  {mass_ratio:5.3f}  {mom_ratio:5.3f}  (n={len(sub)})")
